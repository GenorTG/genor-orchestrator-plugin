{
  "name": "genor-orchestrator-software-house",
  "version": "0.1.0-alpha",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "plugin:build": "npm run build && openclaw plugins build --entry ./dist/index.js",
    "plugin:validate": "npm run build && openclaw plugins validate --entry ./dist/index.js",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "SETUP.md"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "dependencies": {
    "typebox": "^1.2.8"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "openclaw": "^2026.6.5",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "pluginApi": ">=2026.3.24",
    "compat": {
      "pluginApi": ">=2026.3.24"
    },
    "build": {
      "openclawVersion": ">=2026.5.17"
    }
  },
  "description": "AI-powered software house with persistent worker sessions, task execution, and inter-worker collaboration",
  "keywords": [
    "openclaw",
    "plugin",
    "software-house",
    "workers",
    "orchestrator"
  ]
}
