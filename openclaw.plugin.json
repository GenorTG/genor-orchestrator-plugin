{
    "id": "genor-orchestrator",
    "name": "Genor's Orchestrator",
    "description": "Model routing, session logging, live agent tracking, project context automation, ADR tracking, hooks, background maintenance. Dashboard is a separate PM2 sidecar.",
    "version": "0.5.16",
    "configSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
            "orchestratorDataDir": {
                "type": "string",
                "description": "Override for orchestrator-data directory. Defaults to workspace-root/orchestrator-data/ or ORCHESTRATOR_DATA_DIR env."
            },
            "logLevel": {
                "type": "string",
                "enum": [
                    "debug",
                    "info",
                    "warn",
                    "error"
                ],
                "description": "Logging level. (default: info)"
            },
            "logRetentionDays": {
                "type": "number",
                "description": "Days to retain orchestration log entries. (default: 30)"
            },
            "maintenanceIntervalMs": {
                "type": "number",
                "description": "Background maintenance interval in ms. (default: 1800000 = 30min)"
            },
            "dashboardPort": {
                "type": "number",
                "description": "Dashboard web UI port (default: 8767)"
            },
            "dashboardHost": {
                "type": "string",
                "description": "Dashboard hostname override"
            }
        }
    },
    "activation": {
        "onStartup": true
    },
    "contracts": {
        "tools": [
            "orchestrator_set_context",
            "orchestrator_clear_context",
            "orchestrator_get_status",
            "orchestrator_get_config",
            "orchestrator_get_models",
            "orchestrator_check_models",
            "orchestrator_auto_populate",
            "orchestrator_log_session",
            "orchestrator_log_decision",
            "orchestrator_get_logs",
            "orchestrator_sync_project",
            "orchestrator_get_project_docs",
            "orchestrator_advance_phase",
            "orchestrator_get_routing"
        ]
    },
    "openclaw": {
        "build": {
            "openclawVersion": ">=2026.5.17"
        }
    }
}